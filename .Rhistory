library(tidyverse)
library(dplyr)
library(xts)
library(strucchange)
library(vars)
# setwd("https://github.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/Data")
# Data
public_finance <- read.csv("https://raw.githubusercontent.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/refs/heads/main/Data/data.csv")
debt <- read.csv("https://raw.githubusercontent.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/refs/heads/main/Data/debt.csv")
data <- read.csv("https://raw.githubusercontent.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/refs/heads/main/Data/pb.csv")
gdp <- read.csv("https://raw.githubusercontent.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/refs/heads/main/Data/gdp.csv")
revenue <- read.csv("https://raw.githubusercontent.com/Roshann-Rai/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/refs/heads/main/Data/revenue.csv")
# Merge data
df <- public_finance %>%
rename(year = FY1) %>%
left_join(debt, by = "year") %>%
left_join(revenue, by = "year") %>%
dplyr::select(-GDP) %>%
left_join(gdp, by = "year")
# Data Structure
df$year = as.integer(df$year)
df <- df%>%
mutate(across(c(Recurrent, Capital, Interest, Revenue, GDP), ~ as.numeric(gsub(",", "", .x)))) %>%
dplyr::select(-Revenue)
# Required Variables
df1 <- df%>%
dplyr::select(-FY) %>%
mutate(
pb = revenue - Recurrent - Capital + Interest
# pb_gdp = pb/GDP,
# debt_gdp = lag(debt)/GDP # debt beginning of the year
)
view(df1)
df2 <- data %>%
rename(year = FY1) %>%
mutate(pb = -(PB_1 - grant)) %>%
dplyr::select(year, pb)
view(df2)
df3 <- df1 %>%
left_join(df2 %>%
dplyr::select(year, df2_pb = pb), by = "year") %>%
mutate(pb = coalesce(pb, df2_pb)) %>%
dplyr::select(year, debt, GDP, pb)
view(df3)
# 1996 data
df_1996 <- data.frame(
year = 1996,
debt = 160102.2,
GDP = 248913.0,
pb = NA
)
# Merge with df3
merged_df <- bind_rows(df_1996, df3)
str(merged_df)
# Final Dataset
merged_df2 <- merged_df %>%
arrange(year) %>%
mutate(pb_gdp = pb/GDP, debt_gdp = lag(debt)/GDP) %>%
filter(year >= 1997)
view(merged_df2)
# # Plot
# plot1 <- ggplot(merged_df2, aes(year)) +
#   # geom_line(aes(y = pb_gdp, color = "black")) +
#   geom_line(aes(y = debt_gdp, color = "red"))
#
# plot1
# Structural Breaks Bai - Perron
## h = 0.2 means 20% of sample are included in 1 segment
break_yr <- breakpoints(pb_gdp ~ debt_gdp, data = merged_df2, h = 0.20)   # or h = 0.25
summary(break_yr)
plot(break_yr)
break_forced <- breakpoints(break_yr, breaks = 1)  # Gives 1 break
breakdates(break_forced)
merged_df2$year[break_forced$breakpoints]
confint(break_yr)
# Chow test
break_index <- which(merged_df2$year == 2016)
chow_test <- sctest(pb_gdp ~ debt_gdp, type = "Chow", data = merged_df2, point = break_index)
print(chow_test)
sctest(Fstats(pb_gdp ~ debt_gdp, data = merged_df2, from = 0.15, to = 0.85), type = "supF")
t <- Fstats(pb_gdp ~ debt_gdp, data = merged_df2, from = 0.15, to = 0.85)
plot(t)
# Dummy Variable
merged_df2 <- merged_df2 %>%
arrange(year) %>%
mutate(break_yr = ifelse(year > 2015, 1, 0))
# Check the data
table(merged_df2$year, merged_df2$break_yr)
# Required Variables
merged_df3 <- merged_df2 %>%
mutate(
# Lag variables
pb_lag = lag(pb_gdp, 1),
debt_lag = lag(debt_gdp, 1),
# Interaction term
pb_dummy = pb_lag*break_yr,
debt_dummy = debt_lag*break_yr
)
# Lag length Selection
# Because of fewer observations we select lag = 1.
# Model
# Baseline model without structural breaks
pb <- lm(pb_gdp ~ pb_lag + debt_lag, data = merged_df3)
debt <- lm(debt_gdp ~ pb_lag + debt_lag, data = merged_df3)
summary(pb)
summary(debt)
# Ordering pb then debt
df_var <- VAR(
merged_df3 %>% dplyr::select(pb_gdp, debt_gdp),
p = 1,
type = "const"
)
# Impulse response:
# Response of debt to a shock in primary balance
irf_pb <- irf(
df_var,
impulse = "pb_gdp",
response = "debt_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
#Response of primary balance to a shock in debt
irf_debt <- irf(
df_var,
impulse = "debt_gdp",
response = "pb_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
# Ordering debt then pb
df_var1 <- VAR(
merged_df3 %>% dplyr::select(debt_gdp, pb_gdp),
p = 1,
type = "const"
)
# Impulse response:
# Response of debt to a shock in primary balance
irf_pb1 <- irf(
df_var1,
impulse = "pb_gdp",
response = "debt_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
#Response of primary balance to a shock in debt
irf_debt1 <- irf(
df_var1,
impulse = "debt_gdp",
response = "pb_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
plot(irf_pb,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_debt,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_pb1,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_debt1,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
# abline(h = 0, col = "red")
# abline(v = 0, col = "black")
par(mfrow = c(2, 2))
irf_pb1 <- irf(
df_var1,
impulse = "pb_gdp",
response = "debt_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
#Response of primary balance to a shock in debt
irf_debt1 <- irf(
df_var1,
impulse = "debt_gdp",
response = "pb_gdp",
n.ahead = 15,
ortho = TRUE,
boot = TRUE,
runs = 1000,
ci = 0.95
)
par(mfrow = c(2, 2))
plot(irf_pb,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_debt,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_pb1,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot(irf_debt1,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
# abline(h = 0, col = "red")
# abline(v = 0, col = "black")
par(mfrow = c(1, 2))
par(mfrow = c(1, 1))
plot_irf_custom <- function(irf_object, impulse, response, title) {
# Extract IRF estimates and confidence intervals
est <- irf_object$irf[[impulse]][, response]
lo  <- irf_object$Lower[[impulse]][, response]
up  <- irf_object$Upper[[impulse]][, response]
# Horizon starts at zero
h <- 0:(length(est) - 1)
# Set y-axis limits
ylim <- range(c(lo, up, 0))
# Plot IRF
plot(h, est,
type = "l",
lwd = 1,
xlim = c(0, 15),
ylim = ylim,
xaxs = "i",
yaxs = "i",
xlab = "Horizon",
ylab = response,
main = title)
# Bootstrap confidence intervals
lines(h, lo, col = "red", lty = 2)
lines(h, up, col = "red", lty = 2)
# Horizontal zero line
abline(h = 0, col = "red")
# Vertical axis at Horizon 0
abline(v = 0, col = "black")
}
plot_irf_custom(irf_pb,
xlim = c(0, 15),
xaxs = "i",                      # no padding on the x-axis
yaxs = "i",
xlab = "Horizon")
plot_irf_custom(irf_pb,
impulse = "pb_gdp",
response = "debt_gdp",
xlab = "Horizon")
