# Data
public_finance <- read.csv("data.csv")
debt <- read.csv("debt.csv")
# Merge data
df <- public_finance %>%
rename(year = FY1) %>%
left_join(debt, by = "year")
str(df)
# Data Structure
df$year = as.integer(df$year)
df <- df%>%
mutate(across(c(Recurrent, Capital, Interest, Revenue, GDP), ~ as.numeric(gsub(",", "", .x))))
# Required Variables
df <- df%>%
mutate(
pb = Revenue - Recurrent - Capital + Interest,
pd_gdp = pb/GDP,
debt_gdp = lag(debt)/GDP
) %>%
filter(year > 2002)
# Time series object
data_cols <- df[, c("year", "pb_gdp", "debt_gdp")]
finance_ts <- ts(
data = data_cols,
start = df$year,
frequency = 1
)
View(finance_ts)
