# Regression coefficnents
beta_debt <- -0.3109446
beta_debt_sq <- 0.4129780
# Calculate threshold where response turns positive
threshold <- -beta_debt / (2 * beta_debt_sq)
# Should be approximately 37.65%
# Create sequence of debt values (0% to 80% of GDP)
debt_range <- seq(0, 0.80, by = 0.01)
# Calculate marginal fiscal response
# ∂(primary_balance)/∂(debt) = -0.3109446 + 2(0.4129780)×debt
marginal_effect <- beta_debt + 2 * beta_debt_sq * debt_range
# Create data frame
fiscal_reaction <- data.frame(
debt_gdp = debt_range,
marginal_effect = marginal_effect
)
