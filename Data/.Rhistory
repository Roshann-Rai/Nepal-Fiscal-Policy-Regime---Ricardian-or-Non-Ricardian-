# ---------------------------------------------------------
# Continuous-Time New-Keynesian Model with FTPL
# ---------------------------------------------------------
# 1. Parameter Initialization (from Cochrane 2025 specification)
kappa <- 0.25
sigma <- 0.5
r     <- 0.01
rho   <- 0.01
theta <- 0      # Passive Taylor Rule
eta_s <- 0.5    # Assumed fiscal shock decay rate (missing from text)
# 2. State-Space Representation
# State vector: Z = [x, pi, v, s_tilde]'
# Equations:
# dx/dt = sigma*(i - pi) = -sigma*pi  (since i = theta*pi = 0)
# dpi/dt = rho*pi - kappa*x
# dv/dt = r*v + i - pi - s_tilde = r*v - pi - s_tilde
# ds_tilde/dt = -eta_s*s_tilde
A <- matrix(c(
0,      -sigma,  0,  0,
-kappa,   rho,    0,  0,
0,      -1,      r, -1,
0,       0,      0, -eta_s
), nrow = 4, byrow = TRUE)
# 3. Saddle-Path Solution via Eigendecomposition
eig   <- eigen(A)
evals <- eig$values
evecs <- eig$vectors
W     <- solve(evecs) # Left eigenvectors
# Identify explosive (unstable) roots to enforce boundedness
unstable_idx <- which(Re(evals) > 0)
W_unstable   <- W[unstable_idx, ]
# Boundary Conditions at t=0:
# Shock to s_tilde is 1. Real debt v_0 is predetermined (0) due to sticky prices.
s_0 <- 1
v_0 <- 0
# To prevent explosive paths, the initial jumps in x and pi must perfectly offset
# the unstable trajectories. We set the unstable modes to 0:
# W_unstable * Z_0 = 0
C1 <- W_unstable[, 1:2]
C2 <- -W_unstable[, 4] * s_0
jump_0 <- solve(C1, C2)
Z0 <- c(Re(jump_0[1]), Re(jump_0[2]), v_0, s_0)
# 4. Simulate Impulse Response Trajectories
times <- seq(0, 15, length.out = 200)
Z     <- matrix(0, nrow = length(times), ncol = 4)
colnames(Z) <- c("x", "pi", "v", "s_tilde")
for(i in seq_along(times)) {
# Analytical solution: Z(t) = V * exp(Lambda * t) * W * Z0
exp_Lambda <- diag(exp(evals * times[i]))
Z_t        <- evecs %*% exp_Lambda %*% W %*% Z0
Z[i, ]     <- Re(Z_t)
}
# 5. Plotting the Results
par(mfrow = c(2, 2), mar = c(4, 4, 3, 1), bg = "white")
plot(times, Z[, "s_tilde"], type = "l", lwd = 2, col = "purple",
main = "Fiscal Surplus Shock (s_tilde)", xlab = "Time", ylab = "Response")
# ---------------------------------------------------------
# Continuous-Time New-Keynesian Model with FTPL
# ---------------------------------------------------------
par(mfrow = c(2, 2), mar = c(2, 2, 2, 1), bg = "white")
# 1. Parameter Initialization (from Cochrane 2025 specification)
kappa <- 0.25
sigma <- 0.5
r     <- 0.01
rho   <- 0.01
theta <- 0      # Passive Taylor Rule
eta_s <- 0.5    # Assumed fiscal shock decay rate (missing from text)
# 2. State-Space Representation
# State vector: Z = [x, pi, v, s_tilde]'
# Equations:
# dx/dt = sigma*(i - pi) = -sigma*pi  (since i = theta*pi = 0)
# dpi/dt = rho*pi - kappa*x
# dv/dt = r*v + i - pi - s_tilde = r*v - pi - s_tilde
# ds_tilde/dt = -eta_s*s_tilde
A <- matrix(c(
0,      -sigma,  0,  0,
-kappa,   rho,    0,  0,
0,      -1,      r, -1,
0,       0,      0, -eta_s
), nrow = 4, byrow = TRUE)
# 3. Saddle-Path Solution via Eigendecomposition
eig   <- eigen(A)
evals <- eig$values
evecs <- eig$vectors
W     <- solve(evecs) # Left eigenvectors
# Identify explosive (unstable) roots to enforce boundedness
unstable_idx <- which(Re(evals) > 0)
W_unstable   <- W[unstable_idx, ]
# Boundary Conditions at t=0:
# Shock to s_tilde is 1. Real debt v_0 is predetermined (0) due to sticky prices.
s_0 <- 1
v_0 <- 0
# To prevent explosive paths, the initial jumps in x and pi must perfectly offset
# the unstable trajectories. We set the unstable modes to 0:
# W_unstable * Z_0 = 0
C1 <- W_unstable[, 1:2]
C2 <- -W_unstable[, 4] * s_0
jump_0 <- solve(C1, C2)
Z0 <- c(Re(jump_0[1]), Re(jump_0[2]), v_0, s_0)
# 4. Simulate Impulse Response Trajectories
times <- seq(0, 15, length.out = 200)
Z     <- matrix(0, nrow = length(times), ncol = 4)
colnames(Z) <- c("x", "pi", "v", "s_tilde")
for(i in seq_along(times)) {
# Analytical solution: Z(t) = V * exp(Lambda * t) * W * Z0
exp_Lambda <- diag(exp(evals * times[i]))
Z_t        <- evecs %*% exp_Lambda %*% W %*% Z0
Z[i, ]     <- Re(Z_t)
}
# 5. Plotting the Results
par(mfrow = c(2, 2), mar = c(4, 4, 3, 1), bg = "white")
plot(times, Z[, "s_tilde"], type = "l", lwd = 2, col = "purple",
main = "Fiscal Surplus Shock (s_tilde)", xlab = "Time", ylab = "Response")
grid()
plot(times, Z[, "v"], type = "l", lwd = 2, col = "blue",
main = "Real Debt (v)", xlab = "Time", ylab = "Response")
grid()
plot(times, Z[, "pi"], type = "l", lwd = 2, col = "red",
main = "Inflation (pi)", xlab = "Time", ylab = "Response")
grid()
plot(times, Z[, "x"], type = "l", lwd = 2, col = "darkgreen",
main = "Output Gap (x)", xlab = "Time", ylab = "Response")
grid()
install.packages("chattr")
library(tidyverse)
library(dplyr)
library(xts)
library(strucchange)
setwd("D:/Roshan/Nepal-Fiscal-Policy-Regime---Ricardian-or-Non-Ricardian-/Data")
# Data
public_finance <- read.csv("data.csv")
debt <- read.csv("debt.csv")
# Merge data
df <- public_finance %>%
rename(year = FY1) %>%
left_join(debt, by = "year")
str(df)
# Data Structure
df$year = as.integer(df$year)
df <- df%>%
mutate(across(c(Recurrent, Capital, Interest, Revenue, GDP), ~ as.numeric(gsub(",", "", .x))))
# Required Variables
df1 <- df%>%
mutate(
pb = Revenue - Recurrent - Capital + Interest,
pb_gdp = pb/GDP,
debt_gdp = lag(debt)/GDP
) %>%
filter(year >= 2003)
# Plot
plot1 <- ggplot(df1, aes(year)) +
geom_line(aes(y = pb_gdp, color = "black")) +
geom_line(aes(y = debt_gdp, color = "red"))
plot1
# Structural Breaks
# Time series object
# data_cols <- df1[, c("pb_gdp", "debt_gdp")]
# finance_ts <- ts(
#   data = data_cols,
#   start = df$year,
#   frequency = 1
# )
# --- STEP 1: Does a break exist at all? (Bai-Perron) ---
cat("=== Bai-Perron Test (Does a break exist?) ===\n")
bp_test <- sctest(pb_gdp ~ debt_gdp, data = df1, type = "supF")
print(bp_test)
# --- STEP 2: Where is the break? (breakpoints) ---
cat("\n=== Optimal Breakpoint (Where is the break?) ===\n")
bp <- breakpoints(pb_gdp ~ debt_gdp, data = df1)
break_row <- bp$breakpoints
break_year <- df1$year[break_row]
cat("Estimated break year:", break_year, "\n")
# --- STEP 3: Visual confirmation (CUSUM) ---
cat("\n=== CUSUM Plot (Visual check) ===\n")
plot(efp(pb_gdp ~ debt_gdp, data = df1, type = "OLS-CUSUM"),
main = "CUSUM Test for Structural Stability")
# --- STEP 4: Compare with your guess ---
cat("\n=== Conclusion ===\n")
if (break_year == 2018) {
cat("✅ Your guess of 2018 is CONFIRMED by the data.\n")
} else {
cat("⚠️ The data suggests the break is in", break_year,
", not 2018. Consider re-running the Chow test with", break_year, "\n")
}
print(bp_test)
# --- STEP 2: Where is the break? (breakpoints) ---
cat("\n=== Optimal Breakpoint (Where is the break?) ===\n")
bp <- breakpoints(pb_gdp ~ debt_gdp, data = df1)
break_row <- bp$breakpoints
break_year <- df1$year[break_row]
cat("Estimated break year:", break_year, "\n")
# --- STEP 3: Visual confirmation (CUSUM) ---
cat("\n=== CUSUM Plot (Visual check) ===\n")
plot(efp(pb_gdp ~ debt_gdp, data = df1, type = "OLS-CUSUM"),
main = "CUSUM Test for Structural Stability")
# --- STEP 4: Compare with your guess ---
cat("\n=== Conclusion ===\n")
if (break_year == 2018) {
cat("✅ Your guess of 2018 is CONFIRMED by the data.\n")
} else {
cat("⚠️ The data suggests the break is in", break_year,
", not 2018. Consider re-running the Chow test with", break_year, "\n")
}
plot(efp(pb_gdp ~ debt_gdp, data = df1, type = "OLS-CUSUM"),
main = "CUSUM Test for Structural Stability")
cat("Estimated break year:", break_year, "\n")
# Plot
plot1 <- ggplot(df1, aes(year)) +
geom_line(aes(y = pb_gdp, color = "black")) +
geom_line(aes(y = debt_gdp, color = "red"))
plot1
