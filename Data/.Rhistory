marginal_effect = marginal_effect
)
# Create the plot
p1 <- ggplot(fiscal_reaction, aes(x = debt_gdp * 100, y = marginal_effect)) +
# Main reaction function line
geom_line(color = "#0066CC", size = 1.5) +
# Zero line (horizontal)
geom_hline(yintercept = 0, linetype = "dashed",
color = "red", size = 1) +
# Threshold line (vertical)
geom_vline(xintercept = threshold * 100, linetype = "dashed",
color = "blue", size = 0.8, alpha = 0.7) +
# Shaded regions
annotate("rect", xmin = 0, xmax = threshold * 100,
ymin = -Inf, ymax = 0,
fill = "red", alpha = 0.1) +
annotate("rect", xmin = threshold * 100, xmax = 80,
ymin = 0, ymax = Inf,
fill = "green", alpha = 0.1) +
# Labels and annotations
annotate("text", x = threshold * 100 - 2, y = 0.05,
label = paste0("Threshold:\n", round(threshold * 100, 1), "%"),
hjust = 1, size = 4, fontface = "bold", color = "blue") +
#
# annotate("text", x = 20, y = -0.15,
#          label = "PROCYCLICAL ZONE\n(Perverse fiscal response)",
#          color = "darkred", size = 4.5, fontface = "bold") +
annotate("text", x = 58, y = 0.25,
label = "Corrective Action \n in response to rising debt \nat higher level",
color = "darkgreen", size = 4.5, fontface = "bold") +
# Axes and theme
scale_x_continuous(
breaks = seq(0, 80, 10),
labels = function(x) paste0(x, "%")
) +
scale_y_continuous(
breaks = seq(-0.3, 0.4, 0.1),
labels = function(x) sprintf("%.2f", x)
) +
labs(
title = "Fiscal Reaction Function for Nepal",
subtitle = "Marginal Response of Primary Balance to Debt (1975-2023)",
x = "Debt-to-GDP Ratio",
y = "Marginal Fiscal Response\n(∂Primary Balance / ∂Debt)",
caption = paste0(
"Note: Below ", round(threshold * 100, 1),
"% debt/GDP, doesn't react to rising debt.\n",
"Above this threshold, the government begins corrective fiscal adjustment.\n",
"Model: R² = 0.9087, F-statistic = 87.59 (p < 2.2e-16)"
)
) +
theme_minimal(base_size = 13) +
theme(
